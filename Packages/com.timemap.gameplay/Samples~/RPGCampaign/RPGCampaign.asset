        _name: "\u041F\u0440\u043E\u0431\u0443\u0436\u0434\u0435\u043D\u0438\u0435"
        _start: 0
        _binding: {fileID: 0}
        _requirements: []
        _duration: 1.25
        _chronoIndex: 4
        _text: "\u0413\u0435\u0440\u043E\u0439 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442

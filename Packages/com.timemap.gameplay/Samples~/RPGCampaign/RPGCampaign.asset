    - rid: 7647183138202058759
      type: {class: FabulaEvent, ns: TimeMapGameplay, asm: TimeMapGameplay}
      data:
        _id: b97b4817e587454192d18f869c56ad47
        _name: "\u0414\u0435\u0442\u0441\u0442\u0432\u043E \u0433\u0435\u0440\u043E\u044F"
        _start: 2.5
        _binding: {fileID: 0}
        _requirements: []
        _duration: 1.25
        _chronoIndex: 2
        _text: "\u0421\u0438\u0440\u043E\u0442\u0430, \u0432\u044B\u0440\u043E\u0441\u0448\u0438\u0439
          \u043F\u0440\u0438 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0435
